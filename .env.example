# Supabase (project id: hcygbbbbzfpgucqkmxav)
# 신형 API 키 체계 사용 (sb_publishable_* = 구 anon 대체, sb_secret_* = 구 service_role 대체)
NEXT_PUBLIC_SUPABASE_URL=https://hcygbbbbzfpgucqkmxav.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# /admin/metrics 게이트
ADMIN_PASSWORD=

# 배포 URL (OG 태그 절대경로 기준 — Vercel 배포 후 실제 도메인으로)
NEXT_PUBLIC_SITE_URL=

# 시간대 (KST 고정 — CLAUDE.md 시간대 규칙)
TZ=Asia/Seoul

# LLM (선택) — 없으면 분류는 룰만, 요약은 템플릿만 (스텁 경로가 기본 동작).
# 있으면 통화 후 배치 분류/요약에만 사용, 통화당 최대 2회 (가드레일 3).
# 백엔드 선택 우선순위: ANTHROPIC_API_KEY > GEMINI_API_KEY > 스텁.
ANTHROPIC_API_KEY=

# Gemini LLM (현재 기본 사용) — GEMINI_API_KEY 있으면 Anthropic 미설정 시 Gemini 사용.
# GEMINI_MODEL 미설정 시 기본 gemini-2.5-flash (이 키 검증: 2.5-flash / 2.5-flash-lite 만 가용).
GEMINI_API_KEY=
GEMINI_MODEL=

# 통화 발신 cron 인증 — /api/cron/dispatch-calls Bearer 토큰.
# 생성 예: openssl rand -hex 32  → Vercel env(CRON_SECRET) + GitHub secret(CRON_SECRET) 동일값 등록.
CRON_SECRET=

# ── 텔레포니(전화 발신) 벤더 ──────────────────────────────────────────────────
# 어댑터 선택: mock(기본, 동기 시뮬레이션) | clova(스켈레톤) | clawops(실벤더, 비동기 콜백).
# 실벤더 선택 시 해당 벤더 env 가 모두 있어야 발신 시도 — 하나라도 없으면 발신 없이 skip.
TELEPHONY_PROVIDER=mock

# 실벤더 결과 콜백/ VoiceML 인증 시크릿(/api/telephony/callback, /api/telephony/voiceml).
#   - generic/clova: Authorization Bearer 토큰으로 사용.
#   - clawops: URL 쿼리 자체 토큰(HMAC(secret, sessionId))의 파생 시크릿으로 사용.
# 미설정 시 콜백/VoiceML 라우트 비활성(503). 생성 예: openssl rand -hex 32.
TELEPHONY_CALLBACK_SECRET=

# ── ClawOps(실벤더 — 국내 전화 API, Twilio 호환) — provider=clawops 일 때 필수 ──
# 계정·키·발신번호(070-5275-3827) 발급 완료. Base https://api.claw-ops.com.
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM_NUMBER=
# 선택: API 베이스 오버라이드(미지정 시 https://api.claw-ops.com).
CLAWOPS_API_BASE_URL=
# 통화 원가 단가(KRW) — cost_krw 산정 근거. 미설정 시 기본값(회선 60/분, 전사 10/분).
CLAWOPS_COST_PER_MIN_KRW=60
CLAWOPS_TRANSCRIPT_PER_MIN_KRW=10

# ── CLOVA AiCall(스켈레톤 — 미채택, 참고용 유지) — provider=clova 일 때 필수 ──
CLOVA_API_KEY_ID=
CLOVA_API_KEY=
CLOVA_CONTACT_CENTER_ID=
CLOVA_AGENT_ID=
CLOVA_CALLER_NUMBER=
# 선택: API 베이스 URL 오버라이드(미지정 시 벤더 기본 엔드포인트).
CLOVA_API_BASE_URL=
